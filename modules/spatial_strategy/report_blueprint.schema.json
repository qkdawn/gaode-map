{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "executive_summary": { "type": "string", "minLength": 1 },
    "recommended_position": { "type": "string", "minLength": 1 },
    "future_state": { "type": "string", "minLength": 1 },
    "named_entities": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/named_entity" }
    },
    "change_mechanisms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "current_condition": { "type": "string", "minLength": 1 },
          "spatial_action": { "type": "string", "minLength": 1 },
          "intended_effect": { "type": "string", "minLength": 1 }
        },
        "required": ["current_condition", "spatial_action", "intended_effect"],
        "additionalProperties": false
      }
    },
    "target_users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "use_scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1 }
    },
    "function_mix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "function": { "type": "string", "minLength": 1 },
          "users": { "type": "string", "minLength": 1 },
          "spatial_carrier": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        },
        "required": ["function", "users", "spatial_carrier", "role"],
        "additionalProperties": false
      }
    },
    "rejected_alternatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "alternative": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["alternative", "reason"],
        "additionalProperties": false
      }
    },
    "action_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/action" }
    },
    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 36 },
          "judgment": { "type": "string", "minLength": 1 },
          "current_basis": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1 }
          },
          "future_goal": { "type": "string", "minLength": 1 },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "$ref": "#/$defs/action" }
          },
          "intended_effect": { "type": "string", "minLength": 1 }
        },
        "required": [
          "section_id",
          "title",
          "judgment",
          "current_basis",
          "future_goal",
          "actions",
          "intended_effect"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "executive_summary",
    "recommended_position",
    "future_state",
    "named_entities",
    "change_mechanisms",
    "target_users",
    "use_scenarios",
    "function_mix",
    "rejected_alternatives",
    "action_plan",
    "sections"
  ],
  "additionalProperties": false,
  "$defs": {
    "named_entity": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "entity_type": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 },
        "fact": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "entity_type", "relationship", "fact"],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "target_user": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "minLength": 1 },
        "intended_effect": { "type": "string", "minLength": 1 }
      },
      "required": ["action", "target_user", "location", "priority", "intended_effect"],
      "additionalProperties": false
    }
  }
}
