# ========================================
# FastAPI 高德地图扣子插件 环境配置
# ========================================

# 应用配置
# ---------------------------
# 应用主机地址
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://127.0.0.1:8000
# MySQL database config.
# For dynamic public IPs, keep credentials stable in DB_URL and update DB_HOST only.
# DB_HOST overrides the host portion of DB_URL.
DB_HOST=replace-with-current-db-public-ip
DB_PORT=13306
DB_URL=mysql+pymysql://map_app:replace-with-private-password@db.example.com:13306/gaode_deploy?charset=utf8mb4
# Independent PostgreSQL database for AI documents, evidence, and jobs.
POSTGRES_DATABASE_URL=postgresql+psycopg://map_ai:replace-with-private-password@postgres.example.com:5432/gaode_ai

# API密钥配置
# ---------------------------
API_KEYS=["replace-with-strong-api-key"]

# 文件保留时间
FILE_LIFETIME_HOURS=168
CLEANUP_INTERVAL_HOURS=24
# 留空时回退到 runtime/generated_charts
CHART_OUTPUT_DIR=
# Document library uploads
DOCUMENT_UPLOAD_DIR=
DOCUMENT_MAX_MB=50

# 高德地图API配置
# ---------------------------
AMAP_WEB_SERVICE_KEY=
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
TIANDITU_KEY=

# AI Agent provider 配置
# ---------------------------
# 启用后，Agent 会调用 LLM tool loop；当前默认接入 DeepSeek chat completions + tool calling。
AI_ENABLED=false
AI_PROVIDER=deepseek
# OpenAI-compatible gateways such as CSU can use:
# AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
# Fernet key for encrypting personal model API keys. Generate with Fernet.generate_key().
AI_MODEL_CONFIG_SECRET=
EVIDENCE_EMBEDDING_MODEL=BAAI/bge-m3
AI_THINKING_ENABLED=true
AI_TIMEOUT_S=60
PPT_LLM_TIMEOUT_S=0
SEARXNG_BASE_URL=http://127.0.0.1:8004
SEARXNG_TIMEOUT_MS=8000
RESEARCH_SEARCH_TOP_K=8
RESEARCH_CRAWL_TOP_K=5
RESEARCH_SOURCE_MODES=trusted,market
AI_MAX_CONTEXT_TURNS=12
AI_MAX_REPLANS=2

# 本地历史数据查询服务配置
# ---------------------------
# 本地后端默认访问宿主机暴露端口；Docker app 会在 compose 中覆盖为 http://search:8001
LOCAL_QUERY_BASE_URL=http://127.0.0.1:8001
LOCAL_QUERY_COORD_SYSTEM=gcj02
# 8001 历史 POI 查询服务使用独立数据库；Docker Compose 从本文件对应的根 .env 注入。
LOCAL_QUERY_DB_URL=jdbc:mysql://replace-with-current-db-public-ip:13306/aliyunsz?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
LOCAL_QUERY_DB_USERNAME=map_app
LOCAL_QUERY_DB_PASSWORD=replace-with-private-password
LOCAL_QUERY_DB_PLATFORM=org.hibernate.dialect.MySQLDialect

# 等时圈（Isochrone）配置
# ---------------------------
ISOCHRONE_PROVIDER=valhalla
VALHALLA_BASE_URL=http://127.0.0.1:8002
VALHALLA_TIMEOUT_S=60
# 降低线程数以避免 Windows 下 "Two many open files" 错误
VALHALLA_SERVER_THREADS=2

# ArcGIS HTTP bridge
ARCGIS_BRIDGE_ENABLED=true
# 本地后端默认访问宿主机端口；Docker app 会在 compose 中覆盖为 host.docker.internal
ARCGIS_BRIDGE_BASE_URL=http://127.0.0.1:18081
ARCGIS_BRIDGE_TOKEN=
ARCGIS_BRIDGE_TIMEOUT_S=300
ARCGIS_EXPORT_TIMEOUT_S=600
ARCGIS_EXPORT_MAX_MB=512
# Host bridge runtime (used by host_bridge service)
ARCGIS_TOKEN=
ARCGIS_PYTHON_PATH=C:\Python27\ArcGIS10.7\python.exe
ARCGIS_SCRIPT_PATH=D:\Coding\map_analyse\scripts\arcgis_h3_pipeline.py
ARCGIS_ROAD_SYNTAX_SDNA_SCRIPT_PATH=D:\Coding\map_analyse\scripts\arcgis_road_syntax_sdna_global.py
ARCGIS_BRIDGE_PORT=18081

# CORS跨域配置
# ---------------------------
CORS_ORIGINS=["*"]

# 本地路网同源配置（Valhalla + Overpass）
DEPTHMAPX_CLI_PATH=depthmapXcli
OVERPASS_ENDPOINT=http://overpass/api/interpreter
ROAD_SYNTAX_GLOBAL_EDGE_CAP=18000
OVERPASS_PBF_FILE=hunan-260201.osm.pbf
VALHALLA_CUSTOM_FILES_DIR=D:/MapData/osm_source
VALHALLA_TILES_DIR=D:/MapData/valhalla_tiles
OVERPASS_DB_DIR=D:/MapData/overpass_db
OVERPASS_SOURCE_DIR=D:/MapData/osm_source
CITY_BOUNDARY_HOST_DIR=D:/MapData/boundaries
CITY_BOUNDARY_DIR=D:/MapData/boundaries
POPULATION_DATA_HOST_DIR=E:/PeopleData
POPULATION_DATA_DIR=E:/PeopleData
POPULATION_OUTPUT_DIR=/app/runtime/generated_population
POPULATION_PREVIEW_MAX_SIZE=2048
NIGHTLIGHT_DATA_HOST_DIR=E:/NightlightData
NIGHTLIGHT_DATA_DIR=E:/NightlightData/processed
NIGHTLIGHT_PREVIEW_MAX_SIZE=2048
