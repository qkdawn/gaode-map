        <mxCell id="e-a4-a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a5-a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a6-a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a7-a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a8-a9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a9-a10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a10-a11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a10" target="a11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a11-a12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a11" target="a12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a12-store" value="保存稳定结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A62A3;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#665987;" edge="1" parent="1" source="a12" target="decision-store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="258" y="820"/><mxPoint x="360" y="820"/></Array></mxGeometry></mxCell>
        <mxCell id="e-store-blueprint" value="按需读取全部决策" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F8A63;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#356447;" edge="1" parent="1" source="decision-store" target="blueprint-agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-blueprint-store" value="持久化唯一方案" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F8A63;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#356447;" edge="1" parent="1" source="blueprint-agent" target="blueprint-store"><mxGeometry relative="1" as="geometry"/></mxCell>
