  <diagram id="decision-agent-collaboration" name="决策阶段 Agent 协作">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="p2-0"/>
        <mxCell id="p2-1" parent="p2-0"/>

        <mxCell id="p2-title" value="决策阶段：通用决策 Agent 与空间分析 Agent 的协作" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#262B31;" vertex="1" parent="p2-1">
          <mxGeometry x="70" y="30" width="2820" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="p2-subtitle" value="空间分析 Agent 选择问题所需的空间关系与证据域；具体指标选择和计算策略由确定性空间证据工具在内部完成" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#626A73;" vertex="1" parent="p2-1">
          <mxGeometry x="70" y="76" width="2820" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="p2-decision-unit" value="&lt;b&gt;决策单元&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#626A73&quot;&gt;区域角色 / 市场流向 / 供给缺口 / 空间布局等&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5F6872;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#262B31;spacing=8;" vertex="1" parent="p2-1">
          <mxGeometry x="35" y="250" width="150" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="p2-general-box" value="通用决策 Agent" style="swimlane;html=1;rounded=1;arcSize=4;startSize=42;horizontal=1;fillColor=#F7FAFD;swimlaneFillColor=#E8F0F7;strokeColor=#8EA8C0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#31465A;collapsible=0;" vertex="1" parent="p2-1">
          <mxGeometry x="215" y="135" width="700" height="1165" as="geometry"/>
        </mxCell>
        <mxCell id="p2-g1" value="&lt;b&gt;1　接收决策单元任务&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EA8C0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#293B4D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="250" y="205" width="630" height="58" as="geometry"/></mxCell>
        <mxCell id="p2-g2" value="&lt;b&gt;2　读取项目材料与已有领域结果&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EA8C0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#293B4D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="250" y="285" width="630" height="58" as="geometry"/></mxCell>
        <mxCell id="p2-g3" value="&lt;b&gt;3　拆分需要回答的问题&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EA8C0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#293B4D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="250" y="365" width="630" height="58" as="geometry"/></mxCell>
        <mxCell id="p2-g4" value="&lt;b&gt;4　区分空间问题与非空间问题&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8F0F7;strokeColor=#6485A2;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#293B4D;spacing=4;" vertex="1" parent="p2-1"><mxGeometry x="340" y="450" width="450" height="92" as="geometry"/></mxCell>
        <mxCell id="p2-g5" value="&lt;b&gt;5　调用相关领域 Agent 或工具&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#626A73&quot;&gt;非空间问题进入相应领域能力；空间问题交给空间分析 Agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EA8C0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#293B4D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="250" y="575" width="630" height="78" as="geometry"/></mxCell>
        <mxCell id="p2-g6" value="&lt;b&gt;6　综合不同来源的证据&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EA8C0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#293B4D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="250" y="760" width="630" height="58" as="geometry"/></mxCell>
        <mxCell id="p2-g7" value="&lt;b&gt;7　比较候选判断及其边界&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EA8C0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#293B4D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="250" y="840" width="630" height="58" as="geometry"/></mxCell>
        <mxCell id="p2-g8" value="&lt;b&gt;8　形成明确决策、行动建议和待核验事项&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#E8F0F7;strokeColor=#6485A2;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#293B4D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="250" y="920" width="630" height="72" as="geometry"/></mxCell>
        <mxCell id="p2-general-role" value="&lt;b&gt;职责边界&lt;/b&gt;　负责决策问题、证据综合和最终判断；不直接选择底层空间指标，不处理几何与空间计算。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F1F5F9;strokeColor=#8EA8C0;dashed=1;dashPattern=5 4;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#3D5265;align=left;spacing=10;" vertex="1" parent="p2-1"><mxGeometry x="250" y="1190" width="630" height="78" as="geometry"/></mxCell>

        <mxCell id="p2-spatial-box" value="空间分析 Agent" style="swimlane;html=1;rounded=1;arcSize=4;startSize=42;horizontal=1;fillColor=#F7FBF8;swimlaneFillColor=#E6F1E9;strokeColor=#8EAF97;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#34513C;collapsible=0;" vertex="1" parent="p2-1">
          <mxGeometry x="970" y="135" width="760" height="1165" as="geometry"/>
        </mxCell>
        <mxCell id="p2-s1" value="&lt;b&gt;1　理解空间问题&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EAF97;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2F4836;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="190" width="690" height="52" as="geometry"/></mxCell>
        <mxCell id="p2-s2" value="&lt;b&gt;2　将问题拆成可计算的空间子问题&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EAF97;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2F4836;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="255" width="690" height="52" as="geometry"/></mxCell>
        <mxCell id="p2-s3" value="&lt;b&gt;3　选择空间关系&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4F6B57&quot;&gt;• 范围汇总　• 网络可达性与等时圈　• 方向比较&lt;br&gt;• 邻域分析　• 高低值排序　• 跨域空间关系　• 具名对象检查&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#EFF6F1;strokeColor=#78A083;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2F4836;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="320" width="690" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-s4" value="&lt;b&gt;4　选择相关证据域&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4F6B57&quot;&gt;• POI 与设施供给　• 人口规模与结构　• 夜光与夜间活动&lt;br&gt;• 路网结构　• 网络可达性　• 网格及局部空间关系&lt;br&gt;• 具名地点、道路和邻域关系&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#EFF6F1;strokeColor=#78A083;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2F4836;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="458" width="690" height="138" as="geometry"/></mxCell>
        <mxCell id="p2-s5" value="&lt;b&gt;5　规划一次或多次空间工具调用&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EAF97;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2F4836;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="610" width="690" height="54" as="geometry"/></mxCell>
        <mxCell id="p2-s6" value="&lt;b&gt;6　检查计算结果的覆盖范围和方法条件&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EAF97;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2F4836;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="805" width="690" height="58" as="geometry"/></mxCell>
        <mxCell id="p2-s7" value="&lt;b&gt;7　综合为空间发现&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8EAF97;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2F4836;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="880" width="690" height="54" as="geometry"/></mxCell>
        <mxCell id="p2-s8" value="&lt;b&gt;8　生成空间解释与解释性限制&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#E6F1E9;strokeColor=#6F987A;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2F4836;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="950" width="690" height="64" as="geometry"/></mxCell>
        <mxCell id="p2-spatial-role" value="&lt;b&gt;职责边界&lt;/b&gt;　具备空间分析知识，负责选择证据域和分析方法；不直接执行数据库、几何和指标计算。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F1F7F3;strokeColor=#8EAF97;dashed=1;dashPattern=5 4;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#3F5E47;align=left;spacing=10;" vertex="1" parent="p2-1"><mxGeometry x="1005" y="1190" width="690" height="78" as="geometry"/></mxCell>

        <mxCell id="p2-tool-box" value="确定性空间证据工具" style="swimlane;html=1;rounded=1;arcSize=4;startSize=42;horizontal=1;fillColor=#FAFAFA;swimlaneFillColor=#ECEFF1;strokeColor=#A5ACB3;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#3F464D;collapsible=0;" vertex="1" parent="p2-1">
          <mxGeometry x="1785" y="135" width="710" height="1165" as="geometry"/>
        </mxCell>
        <mxCell id="p2-tool-input" value="&lt;b&gt;结构化工具输入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#565E66&quot;&gt;• analysis：空间关系&lt;br&gt;• evidence_domains：证据域&lt;br&gt;• selectors：必要筛选条件&lt;br&gt;• travel_time_bands：必要的时间分带&lt;br&gt;• record_refs：必要的对象引用&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#F5F6F7;strokeColor=#969EA6;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3F464D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="190" width="640" height="148" as="geometry"/></mxCell>
        <mxCell id="p2-t1" value="&lt;b&gt;1　校验结构化分析请求&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#A5ACB3;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#3F464D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="360" width="640" height="48" as="geometry"/></mxCell>
        <mxCell id="p2-t2" value="&lt;b&gt;2　根据分析关系和证据域确定具体计算策略&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#A5ACB3;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#3F464D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="420" width="640" height="54" as="geometry"/></mxCell>
        <mxCell id="p2-t3" value="&lt;b&gt;3　读取保存的空间数据快照&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#A5ACB3;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#3F464D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="486" width="640" height="48" as="geometry"/></mxCell>
        <mxCell id="p2-t4" value="&lt;b&gt;4　执行几何对齐、空间连接和指标计算&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#A5ACB3;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#3F464D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="546" width="640" height="54" as="geometry"/></mxCell>
        <mxCell id="p2-t5" value="&lt;b&gt;5　处理缺失值和有效覆盖&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#A5ACB3;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#3F464D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="612" width="640" height="48" as="geometry"/></mxCell>
        <mxCell id="p2-t6" value="&lt;b&gt;6　返回结构化计算事实&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ECEFF1;strokeColor=#8F979F;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#3F464D;align=left;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="672" width="640" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-tool-output" value="&lt;b&gt;结构化工具输出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#565E66&quot;&gt;• 分组值、排序结果或空间关系结果&lt;br&gt;• 实际使用的指标&lt;br&gt;• 有效样本数与数据覆盖&lt;br&gt;• 计算方法和缺失值处理方式&lt;br&gt;• 数据年份与来源引用&lt;br&gt;• 确定性的运行诊断&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#F5F6F7;strokeColor=#969EA6;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3F464D;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="755" width="640" height="185" as="geometry"/></mxCell>
        <mxCell id="p2-tool-role" value="&lt;b&gt;职责边界&lt;/b&gt;　只返回可复核的空间计算事实；不生成决策结论和解释性限制。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F6F7;strokeColor=#A5ACB3;dashed=1;dashPattern=5 4;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#4B535B;align=left;spacing=10;" vertex="1" parent="p2-1"><mxGeometry x="1820" y="1190" width="640" height="78" as="geometry"/></mxCell>

        <mxCell id="p2-result" value="&lt;b&gt;决策单元结果&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#31465A&quot;&gt;• 明确判断&lt;br&gt;• 支撑证据&lt;br&gt;• 行动建议&lt;br&gt;• 适用边界&lt;br&gt;• 待核验事项&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#5F7183;strokeWidth=1.8;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#293B4D;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="p2-1">
          <mxGeometry x="2570" y="300" width="360" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="p2-boundary-box" value="事实限制与解释性限制必须分开" style="swimlane;html=1;rounded=1;arcSize=4;startSize=42;horizontal=1;fillColor=#FFFFFF;swimlaneFillColor=#F0F2F4;strokeColor=#9AA2AA;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#343A40;collapsible=0;" vertex="1" parent="p2-1">
